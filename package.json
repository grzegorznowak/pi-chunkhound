{
  "name": "pi-chhound",
  "version": "0.0.1",
  "type": "module",
  "description": "ChunkHound worktree, MCP bridge, setup, and status commands for the pi coding agent",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.1",
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "@earendil-works/pi-tui": ">=0.84.1",
    "typebox": ">=1.3.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/tests/run.ts --all",
    "smoke": "npm test",
    "test:unit": "tsx scripts/tests/run.ts --tier unit",
    "test:fs": "tsx scripts/tests/run.ts --tier fs",
    "test:command": "tsx scripts/tests/run.ts --tier command",
    "test:engine": "tsx scripts/tests/run.ts --tier engine",
    "test:robustness": "tsx scripts/tests/run.ts --tier robustness",
    "test:acceptance": "tsx scripts/tests/run.ts --tier acceptance",
    "verify:completions": "tsx scripts/verify-completions.mts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^25.9.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
